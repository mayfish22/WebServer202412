@model List<WebServer.Models.WebServerDB.Product>

@{
    Layout = "_LayoutWithoutMenu";
    var liffID = _configuration.GetValue<string>("LINE:LINELogin:LIFFID");
}

@section Styles {
    <style>
        .card-img-top {
            height: 50%; 
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h5 class="my-4">新品上市</h5>
    <div class="row">
    @foreach (var product in Model)
    {
        <div class="col-4 col-lg-2 mb-3">
            <div class="card h-100">
                <img class="card-img-top product-image" data-id="@product.ID" src="@product.MainImageURL"/>
                <div class="card-body">
                    <h5 class="card-title">@product.ProductName</h5>
                        <h6 class="mt-2 text-muted">NT: @product.UnitPrice.ToString("N0") 元</h6>
                    <p class="card-text">
                        @product.ProductDescription
                    </p>
                        <button type="button" class="btn btn-primary btn-add-shopping-cart" data-id="@product.ID">加到購物車</button>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@section Scripts {
    <script>
        $(async () => {
            // 定義 LIFF ID，這是您在 LINE Developers 控制台中創建的 LIFF 應用的 ID
            const liffID = '@liffID'; 

            // 初始化 LIFF SDK，傳入 liffId
            liff.init({
                liffId: liffID // 設定 LIFF ID
            }).then(async function() {
                // LIFF 初始化成功後執行的代碼

                // 構建一個消息字符串，包含各種 LIFF 相關的資訊
                let msg = `語言：${liff.getLanguage()}`; // 獲取並顯示用戶的語言
                msg += `\nSDK版本：${liff.getVersion()}`; // 獲取並顯示 LIFF SDK 的版本
                msg += `\n作業系統：${liff.getOS()}`; // 獲取並顯示用戶的作業系統
                msg += `\n是否登入 LINE 帳號：${liff.isLoggedIn()}`; // 檢查用戶是否已登入 LINE 帳號
                msg += `\n否由 LINE App 存取：${liff.isInClient()}`; // 檢查應用是否在 LINE 客戶端中運行
                msg += `\nLINE 版本：${liff.getLineVersion()}`; // 獲取並顯示 LINE 應用的版本

                // 顯示上述資訊
                console.log(msg); // 將訊息輸出到控制台

                // 檢查用戶是否已登入 LINE 帳號
                if (!liff.isLoggedIn()) {
                    liff.login(); // 如果未登入，則調用登入方法
                }
                else {
                    // 如果已登入，獲取訪問令牌
                    const accessToken = liff.getAccessToken(); // 獲取用戶的訪問令牌
                    console.log("getAccessToken", accessToken); // 將訪問令牌輸出到控制台

                    // 設定請求的配置
                    const settings = {
                        headers: {
                            'user-agent': navigator.userAgent, // 設定用戶代理
                            'content-type': 'application/json' // 設定內容類型為 JSON
                        },
                        method: 'Post', // 設定請求方法為 POST
                        body: JSON.stringify({ accessToken: accessToken }) // 將訪問令牌作為 JSON 字符串發送
                    };

                    // 發送請求到後端以獲取用戶資料
                    const fetchResponse = await fetch(`/LIFF/GetProfile`, settings); // 發送請求到指定的 URL
                    const result = await fetchResponse.json(); // 解析回應為 JSON 格式
                    console.log(result); // 將結果輸出到控制台
                }
            }).catch(function(error) {
                // 如果初始化失敗，則捕獲錯誤並在控制台中顯示
                console.log(error); // 將錯誤輸出到控制台
            });
        });

        $(async () => {

            // 當用戶點擊類別為 .btn-add-shopping-cart 的按鈕時觸發事件
            $(document).on('click', '.btn-add-shopping-cart', async (e) => {
                // 防呆用，設定 1 秒只能點一次
                $(e.target).attr('disabled', 'disabled'); // 設定為不可點擊

                // 設定 1 秒後恢復可點擊狀態
                setTimeout(function() {
                    $(e.target).removeAttr('disabled');// 恢復可點擊
                }, 1000); 

                // 獲取被點擊按鈕的 data-id 屬性值，這通常用於識別產品
                const productId = $(e.target).attr('data-id');

                // 根據 data-id 獲取對應的產品圖片元素
                const $sourceImage = $(`.product-image[data-id="${productId}"]`);

                // 獲取目標項目（例如用戶的頭像或購物車圖標）
                const $targetItem = $('div.avatar');

                // 獲取源圖片的 src 屬性（圖片路徑）
                const src = $sourceImage.attr('src');

                // 克隆源圖片以便進行動畫
                let $image = $sourceImage.clone();

                // 將克隆的圖片添加到 body 中
                $('body').append($image);

                // 設定克隆圖片的樣式
                $image.css({
                    'position': 'absolute', // 設定為絕對定位，以便自由移動
                    'max-width': '100px',  // 設定最大寬度為 100px
                    'max-height': '100px', // 設定最大高度為 100px
                    'width': '100%',        // 設定寬度為 100% 以保持比例
                    'height': 'auto',       // 高度自動調整以保持圖片比例
                    'left': $(e.target).offset().left, // 設定圖片的初始左邊距為按鈕的左邊距
                    'top': $(e.target).offset().top    // 設定圖片的初始上邊距為按鈕的上邊距
                });

                // 計算圖片移動到目標項目的 X 和 Y 偏移量
                const x = $targetItem.offset().left - $image.offset().left;
                const y = $targetItem.offset().top - $image.offset().top;

                // 使用 move.js 進行動畫效果
                move($image[0])
                    .x(x) // 設定 X 軸移動距離
                    .y(y) // 設定 Y 軸移動距離
                    .duration('2s') // 設定動畫持續時間為 2 秒
                    .scale(0, 0) // 在動畫結束時縮放至 0，實現消失效果
                    .end(async () => {
                        // 動畫結束後移除克隆的圖片
                        $image.remove();
                    });

                // 加入至 CartItem，並取得目前所有品項
                // 設定請求的配置
                const settings = {
                    headers: {
                        'user-agent': navigator.userAgent, // 設定用戶代理
                        'content-type': 'application/json' // 設定內容類型為 JSON
                    },
                    method: 'Post', // 設定請求方法為 POST
                };

                // 發送請求到後端以加入購物車
                const fetchResponse = await fetch(`/CartItem/AddCartItem/${productId}`, settings); // 發送請求到指定的 URL
                const result = await fetchResponse.json(); // 解析回應為 JSON 格式
                $('span.badge.badge-center').text(result.count); // 更新購物車數量
            });
        });

    </script>

}