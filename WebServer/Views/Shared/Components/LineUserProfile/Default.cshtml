@model WebServer.Models.WebServerDB.LINEUser?

@{
    var userName = Model != null ? Model.DisplaName : "尚未登入";
    var userEmail = Model != null ? Model.StatusMessage : string.Empty;
    var userAvatarID = Model != null && !string.IsNullOrEmpty(Model.PictureUrl) ? $"{Model.PictureUrl}" : $"/assets/img/avatars/1.png";
    var cartItems = Model == null ? new List<WebServer.Models.WebServerDB.CartItem>() : await _siteService.GetCartItems(Model.ID).ToListAsync();
}

<!--從 layouts-container.html 取得-->
<!-- User -->
<li class="nav-item navbar-dropdown dropdown-user dropdown">
    <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
        <div class="avatar avatar-online">
            <img src="@userAvatarID" alt class="w-px-40 h-auto rounded-circle" />
        </div>
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <a class="dropdown-item" href="#">
                <div class="d-flex">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar avatar-online">
                            <img src="@userAvatarID" class="w-px-40 h-auto rounded-circle" />
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <span class="fw-semibold d-block">@userName</span>
                        <small class="text-muted">@userEmail</small>
                    </div>
                </div>
            </a>
        </li>
        <li>
            <div class="dropdown-divider"></div>
        </li>
        <li>
            <a class="dropdown-item" href="#" onclick="openOrderHistory()">
                <i class="bx bx-list-check me-2"></i>
                <span class="align-middle">購買記錄</span>
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="#" onclick="openShopcart()">
                <span class="d-flex align-items-center align-middle">
                    <i class="flex-shrink-0 bx bx-cart me-2"></i>
                    <span class="flex-grow-1 align-middle">購物車</span>
                    <span class="flex-shrink-0 badge badge-center rounded-pill bg-danger w-px-20 h-px-20">@(cartItems.Count > 0 ? cartItems.Count.ToString() : string.Empty )</span>
                </span>
            </a>
        </li>
        <li>
            <div class="dropdown-divider"></div>
        </li>
    </ul>
</li>
<!--/ User -->